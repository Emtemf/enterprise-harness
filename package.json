{
  "name": "enterprise-harness",
  "version": "0.3.14",
  "private": true,
  "description": "Portable runtime and repo contract for the Enterprise Harness Claude Code plugin skeleton.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "enterprise-harness": "bin/enterprise-harness.mjs"
  },
  "scripts": {
    "bootstrap": "node runtime/cli.mjs bootstrap",
    "doctor": "node runtime/cli.mjs doctor",
    "sync": "node runtime/cli.mjs sync",
    "verify": "node runtime/cli.mjs verify",
    "install-runtime": "node runtime/cli.mjs install --write-local-adapter",
    "setup-local-adapter": "node runtime/cli.mjs setup-local-adapter --write",
    "start-change": "node runtime/cli.mjs start-change",
    "release-local": "node runtime/cli.mjs release-local",
    "status": "node runtime/cli.mjs status",
    "update": "node runtime/cli.mjs update",
    "upgrade": "node runtime/cli.mjs upgrade",
    "migrate": "node runtime/cli.mjs migrate",
    "upstream-check": "node runtime/cli.mjs upstream-check",
    "workflow": "node runtime/cli.mjs workflow",
    "handoff": "node runtime/cli.mjs handoff",
    "trace": "node runtime/cli.mjs trace",
    "prepublish-check": "node runtime/prepublish.mjs",
    "test:ci": "node runtime/prepublish.mjs",
    "test:all": "node bin/run-smoke-suite.mjs",
    "test:e2e": "node test/external-project/maven-lifecycle-e2e.mjs",
    "test:everything": "npm run test:ci && npm run test:all && npm run docs:check && npm run test:e2e",
    "docs:check": "node runtime/test/docs-consistency-smoke.mjs verify",
    "pack": "node bin/package.mjs",
    "release": "node bin/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "runtime",
    "hooks",
    ".claude-plugin",
    ".claude/skills",
    ".claude/agents",
    ".claude/rules",
    ".mcp.json",
    "harness/specs",
    "harness/schemas",
    "harness/templates",
    "harness/reviewers",
    "harness/upstream",
    "harness/behavior-checks.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "enterprise-harness",
    "agentic-workflow",
    "portable-runtime"
  ]
}
