{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/session-start.mjs\" || true",
            "timeout": 30,
            "statusMessage": "加载 harness 启动检查"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/pre-agent.mjs\" || true",
            "timeout": 10,
            "statusMessage": "校验 scoped Agent 派发"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/pre-write.mjs\" || true",
            "timeout": 30,
            "statusMessage": "执行写入前治理检查"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/pre-explore.mjs\" || true",
            "timeout": 10,
            "statusMessage": "检查代码探索是否已委托 subagent"
          }
        ],
        "matcher": "Grep|Read|Glob|Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/post-agent.mjs\" || true",
            "timeout": 10,
            "statusMessage": "绑定 Agent 派发证据"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/post-write.mjs\" || true",
            "timeout": 60,
            "statusMessage": "执行写入后治理检查"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/agent-failure.mjs\" || true",
            "timeout": 10,
            "statusMessage": "记录 Agent 失败与恢复入口"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/subagent-start.mjs\" || true",
            "timeout": 10,
            "statusMessage": "记录 subagent 启动证据"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/subagent-stop.mjs\" || true",
            "timeout": 10,
            "statusMessage": "校验 subagent 完成证据"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/worktree-create.mjs\" || true",
            "timeout": 30,
            "statusMessage": "从父会话 HEAD 创建受控 worktree"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/task-completed.mjs\" || true",
            "timeout": 10,
            "statusMessage": "校验执行与独立检查接力"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_PLUGIN_ROOT\" && node \"$CLAUDE_PROJECT_DIR/runtime/hooks/stop.mjs\" || true",
            "timeout": 30,
            "statusMessage": "检查完成前验证状态"
          }
        ]
      }
    ]
  }
}
