        <mxCell id="headline" value="而是：错误不能成为“已验收事实”" style="text;html=1;strokeColor=none;fillColor=none;fontSize=34;fontStyle=1;fontColor=#6D28D9;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="1100" height="52" as="geometry"/></mxCell>
        <mxCell id="boundary" value="适用边界：Claude Code 中高风险、需恢复与审计的软件变更；不是所有开发场景的总榜" style="text;html=1;strokeColor=none;fillColor=none;fontSize=17;fontColor=#64748B;align=left;" vertex="1" parent="1"><mxGeometry x="82" y="158" width="1250" height="30" as="geometry"/></mxCell>
