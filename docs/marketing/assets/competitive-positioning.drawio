        <mxCell id="stage-clarify" value="&lt;b&gt;1  Clarify&lt;/b&gt;&lt;br&gt;&lt;br&gt;ResearchPacket&lt;br&gt;requirements.md&lt;br&gt;Decision Ledger&lt;br&gt;歧义结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontSize=17;fontColor=#1E293B;align=left;verticalAlign=top;spacing=20;spacingTop=18;arcSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="295" width="260" height="205" as="geometry"/></mxCell>
