        <mxCell id="sp" value="&lt;b&gt;Superpowers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;优秀工程方法&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontSize=25;fontColor=#065F46;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="440" height="88" as="geometry"/></mxCell>
        <mxCell id="spbody" value="Brainstorming、TDD、fresh subagent、review&lt;br&gt;&lt;br&gt;&lt;b&gt;控制方式&lt;/b&gt;：agent 持续遵守 Skill 方法&lt;br&gt;&lt;b&gt;优势&lt;/b&gt;：轻、成熟、多 harness&lt;br&gt;&lt;b&gt;边界&lt;/b&gt;：无同构 runtime acceptance predicate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontSize=18;fontColor=#1F2937;align=left;verticalAlign=top;spacing=22;spacingTop=18;lineHeight=1.45;" vertex="1" parent="1"><mxGeometry x="80" y="605" width="440" height="210" as="geometry"/></mxCell>
        <mxCell id="os" value="&lt;b&gt;OpenSpec&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;轻量规格资产&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=25;fontColor=#1E3A8A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="440" height="88" as="geometry"/></mxCell>
        <mxCell id="osbody" value="Proposal / Spec / Design / Tasks / Archive&lt;br&gt;&lt;br&gt;&lt;b&gt;控制方式&lt;/b&gt;：可编辑 change artifacts&lt;br&gt;&lt;b&gt;优势&lt;/b&gt;：轻、流动、30+ 工具&lt;br&gt;&lt;b&gt;边界&lt;/b&gt;：Verify 可选且不阻断 Archive&lt;br&gt;&lt;b&gt;本次 pilot&lt;/b&gt;：答复前持久化 6 项业务假设" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontSize=18;fontColor=#1F2937;align=left;verticalAlign=top;spacing=22;spacingTop=18;lineHeight=1.45;" vertex="1" parent="1"><mxGeometry x="580" y="605" width="440" height="210" as="geometry"/></mxCell>
        <mxCell id="eh" value="&lt;b&gt;Enterprise Harness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;运行时 acceptance control plane&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=3;fontSize=25;fontColor=#4C1D95;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="440" height="88" as="geometry"/></mxCell>
        <mxCell id="ehbody" value="Digest freshness、identity、receipt、lineage&lt;br&gt;&lt;br&gt;&lt;b&gt;控制方式&lt;/b&gt;：runtime 每次重算并可拒绝 transition&lt;br&gt;&lt;b&gt;当前 L2 实测&lt;/b&gt;：5/5 无效状态被拒绝；1/1 完整 lineage 通过&lt;br&gt;&lt;b&gt;边界&lt;/b&gt;：最重；仅 Claude Code；token 优势未成立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;fontSize=18;fontColor=#1F2937;align=left;verticalAlign=top;spacing=22;spacingTop=18;lineHeight=1.45;" vertex="1" parent="1"><mxGeometry x="1080" y="605" width="440" height="210" as="geometry"/></mxCell>
        <mxCell id="proof" value="已证明的优势：把 stale、越权、自我批准和缺证据的工作变成“不可验收”&#xa;尚未证明：总体更好、绝对 token 更少、企业 ROI 更高" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="855" width="1260" height="92" as="geometry"/></mxCell>
        <mxCell id="legend" value="证据：L1 固定版本官方合同；L2 当前 checkout 确定性失效注入；pilot n=1 仅诊断" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#64748B;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="955" width="1000" height="28" as="geometry"/></mxCell>
