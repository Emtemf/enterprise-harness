{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/session-start.mjs\"",
            "timeout": 30,
            "statusMessage": "加载 harness 启动检查"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/pre-agent.mjs\"",
            "timeout": 10,
            "statusMessage": "校验 scoped Agent 派发"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/pre-write.mjs\"",
            "timeout": 30,
            "statusMessage": "执行写入前治理检查"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/pre-explore.mjs\"",
            "timeout": 10,
            "statusMessage": "检查代码探索是否已委托 subagent"
          }
        ],
        "matcher": "Grep|Read|Glob|Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/research-evidence.mjs\"",
            "timeout": 10,
            "statusMessage": "记录代码与文档研究证据"
          }
        ],
        "matcher": "mcp__codegraph__.*|mcp__context7__.*|mcp__plugin_enterprise-harness_codegraph__.*|mcp__plugin_enterprise-harness_context7__.*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/post-agent.mjs\"",
            "timeout": 10,
            "statusMessage": "绑定 Agent 派发证据"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/post-write.mjs\"",
            "timeout": 60,
            "statusMessage": "执行写入后治理检查"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/research-evidence.mjs\"",
            "timeout": 10,
            "statusMessage": "记录研究工具失败证据"
          }
        ],
        "matcher": "mcp__codegraph__.*|mcp__context7__.*|mcp__plugin_enterprise-harness_codegraph__.*|mcp__plugin_enterprise-harness_context7__.*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/agent-failure.mjs\"",
            "timeout": 10,
            "statusMessage": "记录 Agent 失败与恢复入口"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/subagent-stop.mjs\"",
            "timeout": 10,
            "statusMessage": "校验 subagent 完成证据"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/task-completed.mjs\"",
            "timeout": 10,
            "statusMessage": "校验执行与独立检查接力"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/stop.mjs\"",
            "timeout": 30,
            "statusMessage": "检查完成前验证状态"
          }
        ]
      }
    ]
  }
}
