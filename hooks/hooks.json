{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.mjs\"",
            "timeout": 30,
            "statusMessage": "加载 harness 启动检查"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/user-prompt-receipt.mjs\"",
            "timeout": 10,
            "statusMessage": "记录用户请求摘要凭据"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-agent.mjs\"",
            "timeout": 10,
            "statusMessage": "校验 scoped Agent 派发"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-write.mjs\"",
            "timeout": 30,
            "statusMessage": "保护受治理写入边界"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-explore.mjs\"",
            "timeout": 10,
            "statusMessage": "检查代码探索是否已委托 subagent"
          }
        ],
        "matcher": "Grep|Read|Glob"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-question.mjs\"",
            "timeout": 10,
            "statusMessage": "校验 Clarify 问题授权"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-agent.mjs\"",
            "timeout": 10,
            "statusMessage": "记录 scoped Agent 派发绑定"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/research-evidence.mjs\"",
            "timeout": 10,
            "statusMessage": "记录研究工具证据"
          }
        ],
        "matcher": "mcp__codegraph__.*|mcp__context7__.*|mcp__plugin_enterprise-harness_codegraph__.*|mcp__plugin_enterprise-harness_context7__.*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-write.mjs\"",
            "timeout": 60,
            "statusMessage": "记录受治理写入边界"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-question.mjs\"",
            "timeout": 10,
            "statusMessage": "记录 Clarify 用户决策"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-start.mjs\"",
            "timeout": 10,
            "statusMessage": "记录 subagent 启动绑定"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-stop.mjs\"",
            "timeout": 30,
            "statusMessage": "记录 subagent 完成证据"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-write-release.mjs\"",
            "timeout": 10,
            "statusMessage": "释放失败写入的治理租约"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/research-evidence.mjs\"",
            "timeout": 10,
            "statusMessage": "记录研究工具失败证据"
          }
        ],
        "matcher": "mcp__codegraph__.*|mcp__context7__.*|mcp__plugin_enterprise-harness_codegraph__.*|mcp__plugin_enterprise-harness_context7__.*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop.mjs\"",
            "timeout": 30,
            "statusMessage": "输出恢复提示"
          }
        ]
      }
    ]
  }
}
