{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.mjs\"",
            "timeout": 30,
            "statusMessage": "加载 harness 启动检查"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-agent.mjs\"",
            "timeout": 10,
            "statusMessage": "校验 scoped Agent 派发"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-write.mjs\"",
            "timeout": 30,
            "statusMessage": "执行写入前治理检查"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-explore.mjs\"",
            "timeout": 10,
            "statusMessage": "检查代码探索是否已委托 subagent"
          }
        ],
        "matcher": "Grep|Read|Glob|Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/research-evidence.mjs\"",
            "timeout": 10,
            "statusMessage": "记录代码与文档研究证据"
          }
        ],
        "matcher": "mcp__codegraph__.*|mcp__context7__.*|mcp__plugin_enterprise-harness_codegraph__.*|mcp__plugin_enterprise-harness_context7__.*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-write.mjs\"",
            "timeout": 60,
            "statusMessage": "执行写入后治理检查"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/research-evidence.mjs\"",
            "timeout": 10,
            "statusMessage": "记录研究工具失败证据"
          }
        ],
        "matcher": "mcp__codegraph__.*|mcp__context7__.*|mcp__plugin_enterprise-harness_codegraph__.*|mcp__plugin_enterprise-harness_context7__.*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop.mjs\"",
            "timeout": 30,
            "statusMessage": "输出恢复提示"
          }
        ]
      }
    ]
  }
}
