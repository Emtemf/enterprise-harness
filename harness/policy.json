{
  "policyVersion": 1,
  "description": "v0.5 narrow policy mapping. Maps stages to capability requirements, governed paths, and artifacts. Does not define lifecycle transitions or review rubric selection; runtime/lib/review-rubrics.mjs is the rubric authority.",
  "governedPaths": [
    "src/main/java/**",
    "src/test/java/**",
    "openapi/**"
  ],
  "stages": {
    "clarify": {
      "facts": ["code-explore", "doc-research"],
      "artifact": "requirements.md"
    },
    "design": {
      "facts": ["code-explore", "doc-research"],
      "artifact": "design.md"
    },
    "plan": {
      "facts": ["code-explore"],
      "artifact": "tasks.md"
    },
    "implement": {
      "facts": ["code-explore"],
      "artifact": "evidence/execution/<task-id>.json",
      "writer": "implementer"
    },
    "verify": {
      "facts": ["code-explore"],
      "artifact": "validation.md"
    },
    "archive": {
      "facts": [],
      "artifact": null
    }
  },
  "completionReviewers": [],
  "factLanes": {
    "code": { "capability": "code-explore", "methodology": "explore-code", "first": "codegraph" },
    "docs": { "capability": "doc-research", "methodology": "research-docs", "first": "context7" }
  }
}
