{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/state.schema.json",
  "title": "Enterprise Harness v6 Change State",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "changeId",
    "lifecycle",
    "stage",
    "impact",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "revision": { "type": "integer", "minimum": 1 },
    "changeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "lifecycle": { "enum": ["active", "archived", "abandoned"] },
    "stage": { "enum": ["clarify", "design", "plan", "implement", "verify", "archive"] },
    "owner": { "type": ["string", "null"] },
    "controller": { "type": "object", "additionalProperties": true },
    "sessionBinding": { "type": ["object", "null"], "additionalProperties": true },
    "changeLock": { "type": ["object", "null"], "additionalProperties": true },
    "impact": {
      "type": "object",
      "required": ["api", "data", "architecture", "rule", "security"],
      "properties": {
        "api": { "enum": ["yes", "no", "unknown"] },
        "data": { "enum": ["yes", "no", "unknown"] },
        "architecture": { "enum": ["yes", "no", "unknown"] },
        "rule": { "enum": ["yes", "no", "unknown"] },
        "security": { "enum": ["yes", "no", "unknown"] }
      },
      "additionalProperties": false
    },
    "classification": { "type": ["object", "null"], "additionalProperties": true },
    "currentTask": { "type": ["string", "null"] },
    "executionStrategy": { "type": ["string", "null"], "enum": ["tdd", "regression", "characterization", "direct", "migration", "generation", null] },
    "artifacts": { "type": "object", "additionalProperties": true },
    "blocker": { "type": ["object", "null"], "additionalProperties": true },
    "tooling": { "type": "object", "additionalProperties": true },
    "validation": {
      "type": "object",
      "required": ["status", "digest", "validatedAt"],
      "properties": {
        "status": { "enum": ["missing", "stale", "fresh"] },
        "digest": { "type": ["string", "null"] },
        "validatedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
