{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/state.schema.json",
  "title": "Enterprise Harness Change State",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "changeId",
    "tier",
    "state",
    "impact",
    "workflow",
    "gates",
    "approvals",
    "validation",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 5 },
    "revision": { "type": "integer", "minimum": 1 },
    "changeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "tier": { "enum": ["L0", "L1", "L2", "L3"] },
    "state": {
      "enum": [
        "DRAFT",
        "CLARIFIED",
        "DESIGNED",
        "DESIGN_APPROVED",
        "PLANNED",
        "EXECUTING",
        "REVIEWED",
        "VALIDATED",
        "ARCHIVED",
        "ABANDONED",
        "REJECTED"
      ]
    },
    "status": { "enum": ["active", "archived", "abandoned"] },
    "lifecycle": { "enum": ["active", "archived", "abandoned"] },
    "controller": { "type": "object", "additionalProperties": true },
    "sessionBinding": { "type": ["object", "null"], "additionalProperties": true },
    "changeLock": { "type": ["object", "null"], "additionalProperties": true },
    "artifacts": { "type": "object", "additionalProperties": true },
    "dependencies": { "type": "object", "additionalProperties": true },
    "blocker": { "type": ["object", "null"], "additionalProperties": true },
    "classification": { "type": ["object", "null"], "additionalProperties": true },
    "currentTask": { "type": ["string", "null"] },
    "impact": {
      "type": "object",
      "required": ["api", "data", "architecture", "rule"],
      "properties": {
        "api": { "enum": ["yes", "no", "unknown"] },
        "data": { "enum": ["yes", "no", "unknown"] },
        "architecture": { "enum": ["yes", "no", "unknown"] },
        "rule": { "enum": ["yes", "no", "unknown"] }
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "required": ["stage", "nextEntry"],
      "properties": {
        "stage": { "enum": ["clarify", "route", "design", "plan", "tdd", "verify", "archive"] },
        "nextEntry": { "type": "string" }
      },
      "additionalProperties": true
    },
    "gates": { "type": "object" },
    "approvals": { "type": "object" },
    "validation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["missing", "stale", "fresh"] },
        "digest": { "type": ["string", "null"] },
        "validatedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "blockers": { "type": "array" }
  },
  "additionalProperties": true
}
