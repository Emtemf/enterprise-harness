{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/question-candidate.schema.json",
  "title": "Enterprise Harness Clarify Question Candidate",
  "type": "object",
  "required": ["questionVersion", "type", "changeId", "questionId", "componentId", "dimension", "decisionNeeded", "whyUserOnly", "header", "question", "options", "recommendedOption", "recommendationReason", "evidenceRefs", "inputDigests", "blocking", "createdAt"],
  "properties": {
    "questionVersion": { "const": 1 },
    "type": { "const": "clarify-question-candidate" },
    "changeId": { "$ref": "#/$defs/safeId" },
    "questionId": { "$ref": "#/$defs/safeId" },
    "componentId": { "$ref": "#/$defs/safeId" },
    "dimension": { "enum": ["Goal", "Scope", "Constraints", "Acceptance", "Context", "TechnicalDebt", "ProjectContract"] },
    "decisionNeeded": { "$ref": "#/$defs/nonEmptyString" },
    "whyUserOnly": { "$ref": "#/$defs/nonEmptyString" },
    "header": { "$ref": "#/$defs/nonEmptyString" },
    "question": { "$ref": "#/$defs/nonEmptyString" },
    "options": { "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/option" } },
    "recommendedOption": { "$ref": "#/$defs/safeId" },
    "recommendationReason": { "$ref": "#/$defs/nonEmptyString" },
    "evidenceRefs": { "$ref": "#/$defs/nonEmptyStrings" },
    "inputDigests": { "$ref": "#/$defs/digestMap" },
    "blocking": { "const": true },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "digestMap": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "option": { "type": "object", "required": ["id", "label", "description"], "properties": { "id": { "$ref": "#/$defs/safeId" }, "label": { "$ref": "#/$defs/nonEmptyString" }, "description": { "$ref": "#/$defs/nonEmptyString" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
