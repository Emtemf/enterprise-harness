{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/project-contract-proposal.schema.json",
  "title": "Enterprise Harness Project Contract Proposal",
  "type": "object",
  "required": ["proposalVersion", "type", "proposalId", "changeId", "targetPath", "operation", "expectedDigest", "resultContent", "durability", "preferenceBasis", "rationale", "resolves", "sourceDecisionIds", "inputDigests", "createdAt"],
  "properties": {
    "proposalVersion": { "const": 1 },
    "type": { "const": "project-contract-proposal" },
    "proposalId": { "$ref": "#/$defs/safeId" },
    "changeId": { "$ref": "#/$defs/safeId" },
    "targetPath": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["create", "append", "replace-managed-block"] },
    "expectedDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "resultContent": { "type": "string", "minLength": 1 },
    "durability": { "enum": ["project-stable", "claude-project"] },
    "preferenceBasis": { "enum": ["explicit-team-rule", "repeated-correction", "approved-baseline"] },
    "rationale": { "type": "string", "minLength": 1 },
    "resolves": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "sourceDecisionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } },
    "inputDigests": { "$ref": "#/$defs/digestMap" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digestMap": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/sha256" } }
  },
  "additionalProperties": false
}
