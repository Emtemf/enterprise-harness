{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/clarify-decision-snapshot.schema.json",
  "title": "Enterprise Harness Clarify Decision Snapshot",
  "type": "object",
  "required": ["snapshotVersion", "type", "changeId", "eventIds", "ledgerRef", "prefixBytes", "prefixDigest", "artifacts", "sealedAt"],
  "properties": {
    "snapshotVersion": { "const": 1 },
    "type": { "const": "clarify-decision-snapshot" },
    "changeId": { "$ref": "#/$defs/safeId" },
    "eventIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } },
    "ledgerRef": { "$ref": "#/$defs/artifactReference" },
    "prefixBytes": { "type": "integer", "minimum": 1 },
    "prefixDigest": { "$ref": "#/$defs/sha256" },
    "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/eventArtifact" } },
    "sealedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactReference": { "type": "object", "required": ["path", "digest"], "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false },
    "eventArtifact": { "type": "object", "required": ["eventId", "digest"], "properties": { "eventId": { "$ref": "#/$defs/safeId" }, "digest": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
