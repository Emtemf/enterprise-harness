{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/completion-proof.schema.json",
  "title": "Enterprise Harness Completion Proof",
  "type": "object",
  "required": ["proofVersion", "type", "changeId", "stage", "artifacts", "target", "evidence", "context", "path", "createdAt"],
  "properties": {
    "proofVersion": { "const": 1 },
    "type": { "const": "completion-proof" },
    "changeId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["clarify", "design", "plan", "implement", "verify", "archive"] },
    "executionRunId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
    "reviewRunId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
    "taskProofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["taskId", "executionRunId", "reviewRunId", "artifacts"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "executionRunId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
          "reviewRunId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
          "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
        },
        "additionalProperties": false
      }
    },
    "waivers": { "type": "array", "items": { "$ref": "waiver.schema.json" } },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "target": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "context": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "path": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "implement" } } },
      "then": { "required": ["taskProofs"] },
      "else": { "required": ["executionRunId", "reviewRunId"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
