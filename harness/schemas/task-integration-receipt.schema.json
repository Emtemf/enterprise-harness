{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/task-integration-receipt.schema.json",
  "title": "Enterprise Harness Task Integration Receipt",
  "type": "object",
  "required": [
    "integrationVersion",
    "type",
    "changeId",
    "taskId",
    "executionReceipt",
    "review",
    "source",
    "subject",
    "changedPaths",
    "integratedAt"
  ],
  "properties": {
    "integrationVersion": { "const": 1 },
    "type": { "const": "task-integration" },
    "changeId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "executionReceipt": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["runId", "parentRunId", "digest"],
      "properties": {
        "runId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
        "parentRunId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["worktreePath", "head", "treeDigest"],
      "properties": {
        "worktreePath": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "treeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["head"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      },
      "additionalProperties": false
    },
    "changedPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "state"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "state": { "enum": ["file", "deleted"] },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "file" } }, "required": ["state"] },
            "then": { "required": ["digest"] }
          },
          {
            "if": { "properties": { "state": { "const": "deleted" } }, "required": ["state"] },
            "then": { "not": { "required": ["digest"] } }
          }
        ],
        "additionalProperties": false
      }
    },
    "integratedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
