{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/task-execution-receipt.schema.json",
  "title": "Enterprise Harness Task Execution Receipt",
  "type": "object",
  "required": [
    "receiptVersion",
    "provenance",
    "changeId",
    "taskId",
    "executionStrategy",
    "agent",
    "worktree",
    "changedPaths",
    "inputDigests",
    "executions",
    "completedAt"
  ],
  "properties": {
    "receiptVersion": { "const": 2 },
    "provenance": { "const": "runtime-runner" },
    "changeId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "executionStrategy": { "enum": ["tdd", "regression", "characterization", "direct", "migration", "generation"] },
    "strategyRationale": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "enterprise-harness:implementer" }
      },
      "additionalProperties": false
    },
    "worktree": {
      "type": "object",
      "required": ["path", "gitCommonDir", "headBefore", "headAfter", "treeDigestBefore", "treeDigestAfter"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "gitCommonDir": { "type": "string", "minLength": 1 },
        "headBefore": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "headAfter": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "treeDigestBefore": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "treeDigestAfter": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inputDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "argv", "outcome", "exitCode", "signal", "spawnError", "startedAt", "finishedAt", "stdoutDigest", "stderrDigest"],
        "properties": {
          "phase": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "outcome": { "enum": ["exit", "signal", "spawn-error"] },
          "exitCode": { "type": ["integer", "null"] },
          "signal": { "type": ["string", "null"] },
          "spawnError": { "type": ["string", "null"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "stdoutDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "stderrDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "outcome": { "const": "exit" } }, "required": ["outcome"] },
            "then": {
              "properties": {
                "exitCode": { "type": "integer" },
                "signal": { "type": "null" },
                "spawnError": { "type": "null" }
              }
            }
          },
          {
            "if": { "properties": { "outcome": { "const": "signal" } }, "required": ["outcome"] },
            "then": {
              "properties": {
                "exitCode": { "type": "null" },
                "signal": { "type": "string", "minLength": 1 },
                "spawnError": { "type": "null" }
              }
            }
          },
          {
            "if": { "properties": { "outcome": { "const": "spawn-error" } }, "required": ["outcome"] },
            "then": {
              "properties": {
                "exitCode": { "type": "null" },
                "signal": { "type": "null" },
                "spawnError": { "type": "string", "minLength": 1 }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
