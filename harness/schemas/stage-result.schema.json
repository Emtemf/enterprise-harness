{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/stage-result.schema.json",
  "title": "Enterprise Harness Stage Result",
  "type": "object",
  "required": ["resultVersion", "type", "changeId", "stage", "runId", "producer", "inputDigests", "artifacts", "assertions", "selfCheck", "tecpc", "status", "needsDecision", "completedAt"],
  "properties": {
    "resultVersion": { "const": 1 },
    "type": { "const": "stage-result" },
    "changeId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["clarify", "design", "plan", "implement", "verify", "archive"] },
    "runId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputDigests": { "$ref": "#/$defs/digestMap" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "waivers": { "type": "array", "items": { "$ref": "waiver.schema.json" } },
    "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
    "selfCheck": { "$ref": "#/$defs/selfCheck" },
    "tecpc": { "$ref": "tecpc.schema.json" },
    "status": { "enum": ["pass", "block", "needs_decision"] },
    "needsDecision": { "type": ["string", "null"] },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "clarify" } }, "required": ["stage"] },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 5,
            "maxItems": 5,
            "allOf": [
              { "contains": { "properties": { "path": { "pattern": "^harness/changes/[^/]+/requirements\\.md$" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "path": { "pattern": "^harness/changes/[^/]+/classification\\.json$" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "path": { "pattern": "^harness/changes/[^/]+/debt-assessment\\.json$" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "path": { "pattern": "^harness/changes/[^/]+/project-contract-assessment\\.json$" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "path": { "pattern": "^harness/changes/[^/]+/evidence/decisions/clarify-decision-snapshot\\.json$" } }, "required": ["path"] }, "minContains": 1, "maxContains": 1 }
            ]
          },
          "assertions": {
            "minItems": 7,
            "maxItems": 7,
            "allOf": [
              { "contains": { "properties": { "id": { "const": "research-complete" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "decisions-durable" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "technical-debt-disposed" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "project-contract-disposed" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "requirements-ready" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "classification-ready" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "id": { "const": "scope-confirmed" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
            ]
          },
          "tecpc": {
            "allOf": [
              { "$ref": "tecpc.schema.json" },
              { "properties": { "path": { "minLength": 1 }, "correction": { "const": null } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "producer": { "type": "object", "required": ["agentType", "skill"], "properties": { "agentType": { "type": "string", "minLength": 1 }, "skill": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "digestMap": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "artifact": { "type": "object", "required": ["path", "digest"], "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
    "assertion": { "type": "object", "required": ["id", "verdict", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "verdict": { "enum": ["pass", "block"] }, "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false },
    "selfCheck": { "type": "object", "required": ["verdict", "findings", "evidence"], "properties": { "verdict": { "enum": ["pass", "block"] }, "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
