{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-harness.local/schemas/stage-result.schema.json",
  "title": "Enterprise Harness Stage Result",
  "type": "object",
  "required": ["resultVersion", "type", "changeId", "stage", "runId", "producer", "inputDigests", "artifacts", "assertions", "tecpc", "status", "needsDecision", "completedAt"],
  "properties": {
    "resultVersion": { "const": 1 },
    "type": { "const": "stage-result" },
    "changeId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["clarify", "design", "plan", "implement", "verify", "archive"] },
    "runId": { "type": "string", "pattern": "^run_[0-9a-f-]{36}$" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputDigests": { "$ref": "#/$defs/digestMap" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
    "tecpc": { "$ref": "tecpc.schema.json" },
    "status": { "enum": ["pass", "block", "needs_decision"] },
    "needsDecision": { "type": ["string", "null"] },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "producer": { "type": "object", "required": ["agentType", "skill"], "properties": { "agentType": { "type": "string", "minLength": 1 }, "skill": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "digestMap": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "artifact": { "type": "object", "required": ["path", "digest"], "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
    "assertion": { "type": "object", "required": ["id", "verdict", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "verdict": { "enum": ["pass", "block"] }, "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
