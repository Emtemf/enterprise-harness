{
  "name": "enterprise-harness-runtime",
  "version": "0.5.3",
  "description": "Portable runtime adapter for the Enterprise Harness project contract.",
  "supportedOs": [
    "linux",
    "darwin",
    "win32"
  ],
  "requiredRuntime": {
    "node": ">=20",
    "claudeCode": ">=2.1.219"
  },
  "requiredProjectFiles": [
    "CLAUDE.md",
    ".claude/settings.json",
    "harness/config.yaml",
    "harness/project.json",
    "harness/specs/architecture.md",
    "harness/specs/workflow.md"
  ],
  "optionalProjectFiles": [
    ".mcp.json",
    "harness/ACTIVE_CHANGE"
  ],
  "commands": {
    "cli": "node runtime/cli.mjs",
    "doctor": "node runtime/cli.mjs doctor",
    "bootstrap": "node runtime/cli.mjs bootstrap",
    "sync": "node runtime/cli.mjs sync",
    "verify": "node runtime/cli.mjs verify",
    "setupLocalAdapter": "node runtime/cli.mjs setup-local-adapter --write",
    "startChange": "node runtime/cli.mjs start-change <change-id> [owner] [tier] [topic]",
    "releaseLocal": "node runtime/cli.mjs release-local",
    "status": "node runtime/cli.mjs status",
    "install": "node runtime/cli.mjs install --write-local-adapter",
    "update": "node runtime/cli.mjs update",
    "upgrade": "node runtime/cli.mjs upgrade",
    "migrate": "node runtime/cli.mjs migrate",
    "upstreamCheck": "node runtime/upstream-check.mjs",
    "lifecycle": "node runtime/cli.mjs lifecycle",
    "workflow": "node runtime/cli.mjs workflow",
    "sessions": "node runtime/cli.mjs sessions",
    "context7": "node runtime/cli.mjs context7",
    "handoff": "node runtime/cli.mjs handoff",
    "trace": "node runtime/cli.mjs trace <run-id> [change-id]"
  },
  "requiredEnvVars": [],
  "notes": [
    "Project secrets must not be committed to the repository.",
    "Context7 MCP is anonymous by default; CONTEXT7_API_KEY in the environment is optional and only needed for higher rate limits.",
    "This manifest describes the portable runtime layer, not the repo contract itself."
  ]
}
